<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?android:attr/colorBackground"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:paddingTop="?attr/actionBarSize">

    <ImageView
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:src="@drawable/logo_utfpr"
        android:adjustViewBounds="true"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sobre o Aplicativo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Este aplicativo foi desenvolvido como projeto da disciplina de Programação para Dispositivos Móveis. Ele permite o gerenciamento e cadastro de um catálogo de produtos para um restaurante, controlando itens, categorias e situação no estoque em tempo real."
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desenvolvido por:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Luan Tarumoto de Macedo\nCurso: Engenharia da Computação\nE-mail: Luan.2002@alunos.utfpr.edu.br"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</LinearLayout>